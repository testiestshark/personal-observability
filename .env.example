# Template for .env.local (gitignored). Fill from `bunx supabase status` for local
# development — those values point at the local Docker stack, not hosted Supabase.
#
# The HOSTED deployment does not read this file. Its public build-time config lives
# in the committed .env.production; secrets live in the host's own settings.
# See docs/ARCHITECTURE.md § Secrets policy.

# Server-side (read via process.env, never inlined into the browser bundle)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Secret — bypasses Row Level Security. Server-side only. Never prefix with VITE_,
# never commit, never place in .env.production.
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (VITE_* are inlined into the browser bundle at build time, so these
# must be public-safe values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
