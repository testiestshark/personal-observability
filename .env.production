# Public, build-time configuration for the HOSTED deployment. Committed on purpose.
#
# Vite inlines VITE_* variables into the client bundle at BUILD time, so these must
# exist when Lovable builds — a gitignored .env on a developer machine cannot reach
# it. Both values below are public by design: they are served to every visitor's
# browser regardless. Data is protected by Row Level Security, not by hiding these.
#
# NEVER put a secret here. In particular no SUPABASE_SERVICE_ROLE_KEY / sb_secret_*
# value, which bypasses RLS. Secrets belong in .env.local (gitignored) or the host's
# secret store. See docs/ARCHITECTURE.md § Secrets policy.
#
# Loaded only for production builds. Local `bun run dev` uses .env.local and is
# unaffected, so local development still points at local Supabase.
VITE_SUPABASE_URL="https://ivdhucdiycnbgvdetagw.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_LPXv0OKC_6ufXbYOq1ywTQ_LbufCZEq"
