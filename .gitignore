# Generated by the TanStack router from the files in src/routes/ — never edited by
# hand, and rebuilt by every `bun run build`.
#
# Untracked on purpose. Two machines generate it and they disagree: a local build
# appends a `declare module` block registering the router's types for SSR, and the
# Lovable build does not. Each then commits its own version over the other's, which
# produced a flip-flop across at least five commits and no useful diffs.
#
# Because it is generated before typecheck rather than committed, `bun run verify`
# and the CI workflow run the build BEFORE `tsc` — without the file, typecheck fails
# on every route. Keep that ordering if either is changed.
src/routeTree.gen.ts
