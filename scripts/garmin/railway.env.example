# Paste these into the Garmin worker service's Railway Variables editor.
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are the public values from
# .env.production. Enter the app password directly in Railway's Variables editor;
# never commit its real value or a Supabase service-role key.
PERSONAL_OBSERVABILITY_ENVIRONMENT=live
PERSONAL_OBSERVABILITY_APP_EMAIL=your-app-login@example.com
PERSONAL_OBSERVABILITY_APP_PASSWORD=enter-directly-in-railway
GARMIN_SYNC_IN_DOCKER=true
GARMIN_TOKEN_STORE=/data/garmin
SUPABASE_SESSION_FILE=/data/supabase-session-live.json
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
RAILWAY_DOCKERFILE_PATH=/scripts/garmin/Dockerfile
