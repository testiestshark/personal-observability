# Paste these into the github-sync service's Railway Variables editor.
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are the public values from
# .env.production (the VITE_ ones). The two app-login values can be reference
# variables to the Garmin service instead of copies, see
# docs/integrations/RAILWAY_GITHUB.md. Enter both GitHub tokens directly in
# Railway's Variables editor and seal them; never commit their real values or a
# Supabase service-role key.
PERSONAL_OBSERVABILITY_APP_EMAIL=your-app-login@example.com
PERSONAL_OBSERVABILITY_APP_PASSWORD=enter-directly-in-railway
GITHUB_SYNC_IN_DOCKER=true
SUPABASE_SESSION_FILE=/data/supabase-session-live.json
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
RAILWAY_DOCKERFILE_PATH=/scripts/github/Dockerfile

# Account A: fine-grained token, Metadata: read. Keeps commit headlines (full).
GITHUB_LOGIN_A=account-a-login
GITHUB_TOKEN_A=enter-directly-in-railway-and-seal
GITHUB_LABEL_A=Personal
GITHUB_DETAIL_A=full

# Account B: classic token with read:user and nothing else. Counts only: no
# repository name or commit headline is ever requested or stored.
GITHUB_LOGIN_B=account-b-login
GITHUB_TOKEN_B=enter-directly-in-railway-and-seal
GITHUB_LABEL_B=Second account
GITHUB_DETAIL_B=counts_only
