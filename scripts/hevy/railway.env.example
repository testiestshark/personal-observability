# Paste these into the Hevy worker service's Railway Variables editor.
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are the public values from
# .env.production. Enter the app password and the Hevy API key directly in
# Railway's Variables editor; never commit their real values or a Supabase
# service-role key.
PERSONAL_OBSERVABILITY_ENVIRONMENT=live
PERSONAL_OBSERVABILITY_APP_EMAIL=your-app-login@example.com
PERSONAL_OBSERVABILITY_APP_PASSWORD=enter-directly-in-railway
HEVY_API_KEY=enter-directly-in-railway
HEVY_SYNC_IN_DOCKER=true
SUPABASE_SESSION_FILE=/data/supabase-session-live.json
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
RAILWAY_DOCKERFILE_PATH=/scripts/hevy/Dockerfile
